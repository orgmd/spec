      "bundles": [
        {
          "bundle_id": "root",
          "content_id": "sha256:aaa",
          "node_path": "root"
        },
        {
          "bundle_id": "leaf",
          "content_id": "sha256:bbb",
          "node_path": "root/leaf"
        }
      ],
      "clearance": ["internal", "public", "public"]
    },
    "expected": {
      "context_id": "sha256:9a3e816cc4b26e84fcfed38a83fa36dfe28669c585cf00d83f5082c8fdf40813"
    }
  },
  {
    "name": "context id preserves designated path order",
    "operation": "context-id",
    "input": {
      "bundles": [
        {
          "bundle_id": "leaf",
