  {
    "name": "parser rejects duplicate YAML keys with a stable source line",
    "operation": "parse",
    "input": {
      "path": "glossary.md",
      "domain": "glossary",
      "text": "---\nid: term.first\nid: term.second\nowner: role.editor\nscope: public\nstatus: approved\nsource: native\nrev: 1\n---\nBody.\n"
